# Copiez ce fichier en .env (jamais commite, voir .gitignore) et completez
# les valeurs reelles. Meme pattern que terraform.tfvars dans le depot
# Terraform.

PORT=3000

# Authentification basique du formulaire (identifiant unique partage)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=REPLACE_ME

# Checkout local d'INFRA-TERRAFORM-PVE-HOME sur cette VM (portal01)
TERRAFORM_REPO_PATH=/opt/infra-terraform

# API Proxmox (utilisee pour la decouverte d'IP : lecture de la config VM
# et de l'agent QEMU). Meme token que celui utilise par Terraform, ou un
# token dedie si vous preferez le separer.
PROXMOX_API_ENDPOINT=https://192.168.10.160:8006/api2/json
PROXMOX_API_TOKEN_ID=terraform_provisioner@pve!provisioner
PROXMOX_API_TOKEN_SECRET=REPLACE_ME
PROXMOX_NODE=PVE-INFRA-MATT-01
PROXMOX_TLS_INSECURE=true

# SSH vers l'hote Proxmox (fallback ARP/tcpdump si l'agent QEMU ne repond
# pas assez vite) - cle dediee a portal01, distincte de celle de Terraform
# sur le poste Windows.
PROXMOX_SSH_HOST=192.168.10.160
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY_PATH=/home/portal/.ssh/id_ed25519_portal_to_proxmox

# SSH vers LPRANSIBLE01 (declenche add-host.py + les playbooks Ansible) -
# cle dediee a portal01, ajoutee au authorized_keys du compte ansible.
CONTROL_NODE_HOST=192.168.10.120
CONTROL_NODE_USER=ansible
CONTROL_NODE_SSH_KEY_PATH=/home/portal/.ssh/id_ed25519_portal_to_control
CONTROL_NODE_REPO_PATH=~/INFRA-ANSIBLE-PVE-HOME
